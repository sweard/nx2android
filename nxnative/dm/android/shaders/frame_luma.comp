#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D frame;
layout(binding = 1, r32f) uniform writeonly image2D luma;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(luma);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(textureSize(frame, 0));
    vec3 color = textureLod(frame, uv + vec2(-1.0, -1.0) * texel, 0.0).rgb
               + textureLod(frame, uv + vec2( 1.0, -1.0) * texel, 0.0).rgb
               + textureLod(frame, uv + vec2(-1.0,  1.0) * texel, 0.0).rgb
               + textureLod(frame, uv + vec2( 1.0,  1.0) * texel, 0.0).rgb;
    float luminance = dot(color * 0.25, vec3(0.2126, 0.7152, 0.0722));
    imageStore(luma, pixel, vec4(sqrt(max(luminance, 0.0))));
}
