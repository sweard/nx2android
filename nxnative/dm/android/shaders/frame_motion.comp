#version 450

// Search in quarter-size luminance. Each group finds one pair of vectors for an 8x8
// block, one row of invocations per direction. Store displacements in luma pixels.
layout(local_size_x = 32, local_size_y = 2) in;
layout(binding = 0) uniform sampler2D previous_luma;
layout(binding = 1) uniform sampler2D current_luma;
layout(binding = 2, rgba16f) uniform writeonly image2D motion;

const int lanes = 32;
const int samples = 9;
shared float reference[2][samples];
shared float costs[2][lanes];
shared ivec2 vectors[2][lanes];
shared ivec2 coarse[2];

ivec2 block_sample(int i) {
    return ivec2(1 + (i % 3) * 2, 1 + (i / 3) * 2);
}

float score(int direction, ivec2 origin, ivec2 limit, ivec2 offset) {
    // Prefer the shortest match when a block is flat or has a repeated pattern.
    float error = 0.001 * float(abs(offset.x) + abs(offset.y));
    for (int i = 0; i < samples; ++i) {
        ivec2 p = clamp(origin + block_sample(i) + offset, ivec2(0), limit);
        float value = direction == 0 ? texelFetch(current_luma, p, 0).r
                                     : texelFetch(previous_luma, p, 0).r;
        error += abs(value - reference[direction][i]);
    }
    return error;
}

void select_best(int direction, int lane, float cost, ivec2 offset) {
    costs[direction][lane] = cost;
    vectors[direction][lane] = offset;
    barrier();
    for (int stride = lanes / 2; stride > 0; stride /= 2) {
        if (lane < stride && costs[direction][lane + stride] < costs[direction][lane]) {
            costs[direction][lane] = costs[direction][lane + stride];
            vectors[direction][lane] = vectors[direction][lane + stride];
        }
        barrier();
    }
}

void main() {
    int lane = int(gl_LocalInvocationID.x);
    int direction = int(gl_LocalInvocationID.y);
    ivec2 origin = ivec2(gl_WorkGroupID.xy) * 8;
    ivec2 limit = textureSize(previous_luma, 0) - 1;
    if (lane < samples) {
        ivec2 p = min(origin + block_sample(lane), limit);
        reference[direction][lane] = direction == 0 ? texelFetch(previous_luma, p, 0).r
                                                   : texelFetch(current_luma, p, 0).r;
    }
    barrier();

    float best = 1e6;
    ivec2 offset = ivec2(0);
    for (int i = lane; i < 49; i += lanes) {
        ivec2 candidate = (ivec2(i % 7, i / 7) - 3) * 4;
        float cost = score(direction, origin, limit, candidate);
        if (cost < best) {
            best = cost;
            offset = candidate;
        }
    }
    select_best(direction, lane, best, offset);
    if (lane == 0) coarse[direction] = vectors[direction][0];
    barrier();

    best = 1e6;
    if (lane < 25) {
        offset = coarse[direction] + ivec2(lane % 5, lane / 5) - 2;
        best = score(direction, origin, limit, offset);
    }
    select_best(direction, lane, best, offset);
    if (lane == 0) {
        // When even the best match changes most of the block (e.g. a scene cut),
        // leave it to the synthesis pass to choose the current frame.
        coarse[direction] = costs[direction][0] < 1.35 ? vectors[direction][0] : ivec2(0);
    }
    barrier();
    if (lane == 0 && direction == 0)
        imageStore(motion, ivec2(gl_WorkGroupID.xy), vec4(vec2(coarse[0]), vec2(coarse[1])));
}
