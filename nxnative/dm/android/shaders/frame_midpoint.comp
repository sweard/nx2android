#version 450

layout(local_size_x = 16, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D previous_frame;
layout(binding = 1) uniform sampler2D current_frame;
layout(binding = 2) uniform sampler2D motion;
layout(binding = 3, rgba16f) uniform writeonly image2D midpoint;

float difference(vec3 a, vec3 b) {
    vec3 d = abs(a - b);
    return max(d.r, max(d.g, d.b));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(midpoint);
    if (any(greaterThanEqual(pixel, size))) return;

    vec2 center = vec2(pixel) + 0.5;
    vec2 uv = center / vec2(size);
    vec3 old_color = textureLod(previous_frame, uv, 0.0).rgb;
    vec3 color = textureLod(current_frame, uv, 0.0).rgb;
    // Opaque HUD pixels that match at the same screen position should stay there.
    if (difference(old_color, color) > 0.006) {
        vec2 luma_size = vec2((size + 3) / 4);
        vec2 motion_size = vec2(textureSize(motion, 0));
        vec4 flow = textureLod(motion, uv * luma_size / (8.0 * motion_size), 0.0);
        vec2 a_uv = uv - flow.xy * (0.5 / luma_size);
        vec2 b_uv = uv - flow.zw * (0.5 / luma_size);
        if (length(flow.xy + flow.zw) <= 2.5 &&
            all(greaterThanEqual(min(a_uv, b_uv), vec2(0.0))) &&
            all(lessThanEqual(max(a_uv, b_uv), vec2(1.0)))) {
            vec3 a = textureLod(previous_frame, a_uv, 0.0).rgb;
            vec3 b = textureLod(current_frame, b_uv, 0.0).rgb;
            // Avoid a double image at an occlusion or after a scene change.
            float weight = 1.0 - smoothstep(0.04, 0.18, difference(a, b));
            color = mix(color, (a + b) * 0.5, weight);
        }
    }
    imageStore(midpoint, pixel, vec4(color, 1.0));
}
